#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/radiusd
CONF_DIR=/etc/radius4wifi
PKI_DIR=/etc/radius4wifi/certs/pki
RUN_DIR=/var/run/radius4wifi

generate_certs() {
    [ -d "$PKI_DIR" ] || mkdir -p "$PKI_DIR"

    # Generate CA if missing
    if [ ! -f "$PKI_DIR/ca.crt" ]; then
        openssl ecparam -name prime256v1 -genkey -out "$PKI_DIR/ca.key"
        openssl req -x509 -new -nodes -key "$PKI_DIR/ca.key" -sha256 -days 3650 \
            -out "$PKI_DIR/ca.crt" -subj "/CN=Radius4WiFi CA"
    fi

    # Generate Server Cert if missing
    if [ ! -f "$PKI_DIR/server.crt" ]; then
        openssl ecparam -name prime256v1 -genkey -out "$PKI_DIR/server.key"
        openssl req -new -key "$PKI_DIR/server.key" -out "$PKI_DIR/server.csr" \
            -subj "/CN=Radius4WiFi Server" -nodes
        openssl x509 -req -in "$PKI_DIR/server.csr" -CA "$PKI_DIR/ca.crt" \
            -CAkey "$PKI_DIR/ca.key" -CAcreateserial -out "$PKI_DIR/server.crt" -days 3650
    fi
}

generate_clients_config() {
    local clients_file="$CONF_DIR/clients.conf"
    echo "# Auto-generated RADIUS clients" > "$clients_file"

    local count=1
    process_server() {
        local section="$1"
        local secret
        config_get secret "$section" secret "testing123"

        append_client() {
            local ip="$1"
            [ -z "$ip" ] && return
            cat <<EOF >> "$clients_file"
client ap_${count} {
    ipaddr = ${ip}
    secret = ${secret}
}
EOF
            count=$((count + 1))
        }

        config_list_foreach "$section" client_net append_client
    }

    config_foreach process_server server
}

start_service() {
    config_load radius4wifi

    mkdir -p "$RUN_DIR" "$CONF_DIR/certs" "$PKI_DIR"

    generate_certs
    generate_clients_config

    chown -R radius4wifi:radius4wifi "$CONF_DIR" "$RUN_DIR"

    procd_open_instance
    procd_set_param command "$PROG" -f -d "$CONF_DIR"
    procd_set_param user radius4wifi
    procd_set_param group radius4wifi
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "radius4wifi"
}
