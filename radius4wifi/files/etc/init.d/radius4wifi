#!/bin/sh /etc/rc.common

START=50
USE_PROCD=1

PKI_DIR="/etc/radius4wifi/pki"

generate_pki() {
[ -d "$PKI_DIR" ] || mkdir -p "$PKI_DIR"

# Only generate if CA key does not exist
if [ ! -f "$PKI_DIR/ca.key" ]; then
    logger -t radius4wifi "No PKI found. Generating self-signed ECC (prime256v1) CA and server certificates..."

    # 1. Generate ECC CA Key & Certificate
    openssl ecparam -name prime256v1 -genkey -out "$PKI_DIR/ca.key" >/dev/null 2>&1
    openssl req -x509 -new -nodes -key "$PKI_DIR/ca.key" -sha256 \
        -out "$PKI_DIR/ca.pem" -days 3650 \
        -subj "/CN=Radius4WiFi CA" >/dev/null 2>&1

    # 2. Generate ECC Server Key & CSR
    openssl ecparam -name prime256v1 -genkey -out "$PKI_DIR/server.key" >/dev/null 2>&1
    openssl req -new -key "$PKI_DIR/server.key" \
        -out "$PKI_DIR/server.csr" \
        -subj "/CN=Radius4WiFi Server" -nodes >/dev/null 2>&1

    # 3. Sign Server Cert with CA
    openssl x509 -req \
        -in "$PKI_DIR/server.csr" \
        -CA "$PKI_DIR/ca.pem" \
        -CAkey "$PKI_DIR/ca.key" \
        -CAcreateserial \
        -out "$PKI_DIR/server.pem" \
        -days 3650 >/dev/null 2>&1

    chmod 600 "$PKI_DIR"/*.key
    logger -t radius4wifi "ECC PKI auto-generation complete."
fi
}

start_service() {
generate_pki

procd_open_instance "main"
procd_set_param command /usr/sbin/radiusd -f
procd_set_param respawn 3600 5 0
procd_close_instance
}