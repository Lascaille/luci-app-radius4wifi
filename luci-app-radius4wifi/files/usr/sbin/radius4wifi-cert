#!/bin/sh

PKI_DIR="/etc/radius4wifi/pki"
CERTS_DIR="/etc/radius4wifi/certs"

generate_certs() {
    echo "Generating new ECC (prime256v1) CA and server certificates..."
    mkdir -p "$PKI_DIR" "$CERTS_DIR"

    openssl ecparam -name prime256v1 -genkey -out "$PKI_DIR/ca.key"
    openssl req -x509 -new -nodes -key "$PKI_DIR/ca.key" -sha256 \
        -out "$PKI_DIR/ca.pem" -days 3650 \
        -subj "/CN=Radius4WiFi CA"

    openssl ecparam -name prime256v1 -genkey -out "$PKI_DIR/server.key"
    openssl req -new -key "$PKI_DIR/server.key" \
        -out "$PKI_DIR/server.csr" \
        -subj "/CN=Radius4WiFi Server" -nodes

    openssl x509 -req \
        -in "$PKI_DIR/server.csr" \
        -CA "$PKI_DIR/ca.pem" \
        -CAkey "$PKI_DIR/ca.key" \
        -CAcreateserial \
        -out "$PKI_DIR/server.pem" \
        -days 3650

    chmod 600 "$PKI_DIR"/*.key
}

reset_pki() {
    echo "Wiping PKI infrastructure and client certificates..."
    rm -rf "$PKI_DIR"/* "$CERTS_DIR"/*
    generate_certs
}

case "$1" in
    generate|regen)
        generate_certs
        ;;
    reset)
        reset_pki
        ;;
    *)
        echo "Usage: $0 {generate|regen|reset}"
        exit 1
        ;;
esac